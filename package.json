{
  "name": "@kelaocai/dsh-localsend",
  "version": "0.1.1",
  "description": "在 DeepSeek Harness 里用 LocalSend 协议（v2）在局域网内发现设备、收发文件。让 Agent 直接发现手机/其他电脑上的 LocalSend 并互相传文件，无需云端上传。Send and receive files over the local network via the LocalSend protocol.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "localsend",
    "file-transfer",
    "lan",
    "airdrop",
    "局域网",
    "传文件"
  ],
  "license": "MIT",
  "author": "kelaocai",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./protocol": "./protocol.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "protocol.js",
    "cordis.patch.yml",
    "market/",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelaocai/dsh-localsend.git"
  },
  "homepage": "https://github.com/kelaocai/dsh-localsend#readme",
  "bugs": {
    "url": "https://github.com/kelaocai/dsh-localsend/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "release:check": "npm test && npm publish --dry-run",
    "release": "npm run release:check && npm publish"
  }
}
